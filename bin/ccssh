#!/usr/bin/env bash
# ccssh — choose a host, folder and branch, then run Claude Code there.
set -uo pipefail

# Installing puts a symlink on PATH, and BASH_SOURCE then reports the link's
# own path — so resolve it before looking for the scripts next door.
_ccssh_source="${BASH_SOURCE[0]}"
while [ -L "$_ccssh_source" ]; do
  _ccssh_dir="$(cd -P "$(dirname "$_ccssh_source")" && pwd)"
  _ccssh_source="$(readlink "$_ccssh_source")"
  case "$_ccssh_source" in
    /*) ;;
    *) _ccssh_source="$_ccssh_dir/$_ccssh_source" ;;
  esac
done
CCSSH_ROOT="$(cd -P "$(dirname "$_ccssh_source")/.." && pwd)"
unset _ccssh_source _ccssh_dir
for _module in lib hosts environments picker probe auth install folders worktree memory relay session; do
  # shellcheck source=/dev/null
  . "$CCSSH_ROOT/scripts/$_module.sh"
done

CCSSH_VERSION_STRING="0.1.0"
CCSSH_DRY_RUN="${CCSSH_DRY_RUN:-0}"
# New by default, the way `claude` itself starts a new conversation unless you
# ask for --continue or --resume.
CCSSH_SESSION_MODE="${CCSSH_SESSION_MODE:-new}"
CCSSH_TAKEOVER="${CCSSH_TAKEOVER:-0}"
CCSSH_VERBOSE="${CCSSH_VERBOSE:-0}"

usage() {
  cat <<'EOF'
ccssh — get to Claude Code on another machine, fast

  ccssh                  pick an environment, land where you left off
  ccssh <environment>    go straight to one you have named
  ccssh <host>           go straight to a host
  ccssh <host>:<path>    go straight to a directory
  ccssh --save <name>    name where you are going, for next time
  ccssh -c               continue the session you left there
  ccssh -r               pick among the sessions open there
  ccssh -p               pick the directory again
  ccssh -b               pick a branch or worktree too
  ccssh --takeover       detach whoever else is attached
  ccssh --local          run Claude Code here
  ccssh --forget [host]  forget where you left off
  ccssh --dry-run        walk through it, change nothing
  ccssh -v               show every step instead of one status line
  ccssh --version        print the version

An environment is a name for a place you work: an SSH host, a directory on it,
optionally a branch. Naming one is optional — a bare host works, and each host
remembers the directory you were last in either way.

Run ccssh from anywhere; it has no opinion about your local directory.
EOF
}

# --- selection --------------------------------------------------------------

# Parallel arrays: what the user sees, and what it means.
labels=()
values=()

add_choice() {
  labels+=("$1")
  values+=("$2")
}

# value_for <chosen-label>
value_for() {
  local i
  for i in "${!labels[@]}"; do
    if [ "${labels[$i]}" = "$1" ]; then
      printf '%s\n' "${values[$i]}"
      return 0
    fi
  done
  return 1
}

choose_host() {
  local chosen host dir last label name env_host env_dir env_branch
  local -a rest=()

  last="$(ccssh_memory_last_host)"

  # Order: what you wrote down, then where you were, then that same host
  # without a directory, then Local, then everything else. The idea is that
  # the top of the list is where you almost certainly want to go, and the
  # second entry is the same machine when you want a different directory.
  while IFS=$'	' read -r name env_host env_dir env_branch; do
    [ -n "$name" ] || continue
    label="◇ $name"
    [ -n "$env_dir" ] && label="$label   $env_host · $env_dir"
    [ -n "$env_branch" ] && label="$label · $env_branch"
    add_choice "$label" "env:$name"
  done < <(ccssh_environments)

  if [ -n "$last" ]; then
    dir="$(ccssh_memory_get "$last" | cut -f1)"
    label="★ $last"
    [ -n "$dir" ] && label="$label   $dir"
    add_choice "$label" "resume:$last"
    # The same host, with no directory attached: this is how you go back to
    # that machine and pick somewhere else.
    add_choice "◆ $last" "host:$last"
  fi

  add_choice "▪ Local" "local"

  while IFS= read -r host; do
    [ -n "$host" ] || continue
    [ "$host" = "$last" ] && continue
    add_choice "◆ $host" "host:$host"
  done < <(ccssh_list_hosts)

  if [ "${#labels[@]}" -le 1 ]; then
    die "setup" "no SSH hosts found in ~/.ssh/config" \
      "add a Host entry, or run: ccssh --local"
  fi

  chosen="$(ccssh_pick "Where do you want to work?" "${labels[@]}")" || exit 130
  [ -n "$chosen" ] || exit 130
  value_for "$chosen"
}

choose_folder() {
  local host="$1" chosen typed
  local -a options=()

  while IFS= read -r line; do
    [ -n "$line" ] && options+=("$line")
  done < <(ccssh_list_repos "$host")

  options+=("… type a path")

  chosen="$(ccssh_pick "Folder on $host?" "${options[@]}")" || exit 130
  [ -n "$chosen" ] || exit 130

  if [ "$chosen" = "… type a path" ]; then
    typed="$(ccssh_prompt_path "$host" "$CCSSH_HOME/")" || exit 130
    [ -n "$typed" ] || die "folder" "no path given"
    typed="$(ccssh_expand_home "$typed" "$CCSSH_HOME")"
    ccssh_dir_exists "$host" "$typed" ||
      die "folder" "$typed does not exist on $host"
    printf '%s\n' "$typed"
    return 0
  fi

  printf '%s\n' "$chosen"
}

# choose_branch <host> <repo> — prints "branch<TAB>path", empty for the repo itself.
choose_branch() {
  local host="$1" repo="$2" current chosen branch path
  local -a options=()

  current="$(ccssh_current_branch "$host" "$repo")"
  options+=("● current${current:+ ($current)}")

  while IFS=$'\t' read -r branch path; do
    [ -n "$branch" ] && options+=("⌥ $branch")
  done < <(ccssh_worktree_list "$host" "$repo")

  options+=("+ new worktree")

  chosen="$(ccssh_pick "Branch in $(basename "$repo")?" "${options[@]}")" || exit 130
  [ -n "$chosen" ] || exit 130

  case "$chosen" in
    "● current"*)
      return 0
      ;;
    "+ new worktree")
      branch="$(ccssh_prompt "New branch name:")" || exit 130
      ccssh_branch_valid "$branch" ||
        die "worktree" "'$branch' is not a usable branch name" \
          "avoid spaces, leading slashes and '..'"
      path="$(ccssh_worktree_path "$repo" "$branch")" ||
        die "worktree" "could not place a worktree for '$branch'"
      info "creating worktree at $path"
      ccssh_worktree_create "$host" "$repo" "$branch" "$path" ||
        die "worktree" "git could not create the worktree" \
          "check that $repo is a clean git repository on $host"
      ok "worktree ready"
      printf '%s\t%s\n' "$branch" "$path"
      ;;
    *)
      branch="${chosen#⌥ }"
      while IFS=$'\t' read -r b p; do
        if [ "$b" = "$branch" ]; then
          printf '%s\t%s\n' "$b" "$p"
          return 0
        fi
      done < <(ccssh_worktree_list "$host" "$repo")
      die "worktree" "worktree for '$branch' vanished"
      ;;
  esac
}

# --- connecting -------------------------------------------------------------

prepare_remote() {
  local host="$1" candidate_dir="${2:-}" candidate_session="${3:-}"

  status "connecting to ${host}…"
  ccssh_probe "$host" "$candidate_dir" "$candidate_session" ||
    die "connect" "cannot reach $host" "check it manually with: ssh $host"

  ccssh_platform_supported ||
    die "probe" "unsupported remote platform: ${CCSSH_OS:-unknown}" \
      "ccssh v1 supports Linux and macOS hosts"

  [ -n "$CCSSH_PYTHON" ] ||
    die "probe" "python3 is not installed on $host" \
      "it is needed to install the credential safely"

  [ -n "$CCSSH_GIT" ] || say_warn "git not found on $host — branch selection is unavailable"

  if [ -z "$CCSSH_CLAUDE" ]; then
    if [ "$CCSSH_DRY_RUN" = "1" ]; then
      info "would install Claude Code on $host"
    else
      say_warn "Claude Code is not installed on $host — installing it now"
      ccssh_install_claude "$host" ||
        die "install" "the installer did not leave a working claude on $host" \
          "install it manually there, then run ccssh again"
      ccssh_probe "$host" || die "probe" "lost contact with $host after installing"
      say_ok "claude ${CCSSH_VERSION:-ready} on $host"
    fi
  else
    status "$host · claude ${CCSSH_VERSION:-ready}"
    ccssh_report_version_drift "$host"
  fi

  # Persistence is worth a package install: without tmux, a dropped connection
  # loses the session. Not worth failing over, though.
  if [ -z "$CCSSH_TMUX" ]; then
    if [ "$CCSSH_DRY_RUN" = "1" ]; then
      info "would install tmux on $host"
    else
      ccssh_install_tmux "$host" &&
        say_ok "tmux installed on $host" ||
        say_warn "continuing without tmux — the session ends if the connection drops"
    fi
  fi

  if [ "$CCSSH_DRY_RUN" = "1" ]; then
    local hours=''
    hours="$(ccssh_read_credential 2>/dev/null | ccssh_credential_hours_left)" || true
    if [ -n "$hours" ]; then
      info "would forward credentials (access token valid for ${hours}h)"
    else
      info "would forward credentials"
    fi
    return 0
  fi

  status "$host · sending credentials"
  ccssh_forward_credential "$host" ||
    say_warn "run 'claude' once on $host to log in"

  # mosh is never installed unasked: it needs UDP 60000-61000 open, which on a
  # VPS is a firewall change only the owner can make.
  if [ -z "${CCSSH_MOSH_SERVER:-}" ] && command -v mosh >/dev/null 2>&1 &&
     ccssh_host_option "$host" useMosh true; then
    say_info "tip: install mosh on $host and the session will reattach by itself"
  fi
}

run_remote() {
  local host="$1" dir="$2" branch="${3:-}" worktree="${4:-}"
  local workdir="$dir" session relay_pid='' status=0

  [ -n "$worktree" ] && workdir="$worktree"
  session="$(ccssh_session_name "$dir" "$branch")"

  session="$(resolve_session "$host" "$session")" || exit 130

  # Catch a bad path here, where we can say which one and why, rather than
  # letting the remote shell fail with a bare "no such file or directory".
  ccssh_dir_exists "$host" "$workdir" ||
    die "session" "$workdir does not exist on $host" \
      "run: ccssh --forget    then pick the folder again"

  if [ "$CCSSH_DRY_RUN" = "1" ]; then
    log ""
    if [ "$CCSSH_FORWARDED" = "1" ] && ! ccssh_renewal_enabled "$host"; then
      info "would relay renewed tokens every $((CCSSH_RELAY_INTERVAL / 60))m while the session runs"
    fi
    info "would remember for $host: $dir${branch:+  ($branch)}"
    info "would run: ssh -t $host \"$(ccssh_remote_command "$workdir" "$session")\""
    info "persistence: $(ccssh_multiplexer)"
    log ""
    ok "dry run — nothing was changed on $host"
    return 0
  fi

  ccssh_memory_put "$host" "$dir" "$branch" "$worktree"

  # While the session runs, keep the remote in step with whatever token this
  # machine holds. Pointless when the remote renews itself, and nothing to
  # relay when forwarding is off for this host.
  if [ "$CCSSH_FORWARDED" = "1" ] && ! ccssh_renewal_enabled "$host"; then
    relay_pid="$(ccssh_relay_start "$host" "$CCSSH_FORWARDED_EXPIRY" "$$")"
    trap 'ccssh_relay_stop "$relay_pid"' EXIT INT TERM
  fi

  log ""
  ccssh_run_session "$host" "$workdir" "$session" || status=$?

  ccssh_relay_stop "$relay_pid"
  trap - EXIT INT TERM
  exit "$status"
}

forget_host() {
  local host="${1:-}" result
  result="$(ccssh_memory_forget "$host")"
  if [ -n "$host" ]; then
    ok "forgot $host"
  else
    ok "forgot ${result:-0} host(s)"
  fi
}

# resolve_session <host> <base>
#
# A fresh session unless asked otherwise, mirroring `claude`: running it starts
# a new conversation, and -c / -r are how you get back to an old one.
resolve_session() {
  local host="$1" base="$2" latest chosen name attached
  local -a options=()

  case "$CCSSH_SESSION_MODE" in
    continue)
      latest="$(ccssh_session_latest "$host" "$base")"
      if [ -n "$latest" ]; then
        printf '%s\n' "$latest"
      else
        say_info "nothing open there yet — starting a session"
        printf '%s\n' "$base"
      fi
      ;;
    resume)
      while IFS=$'\t' read -r name attached; do
        [ -n "$name" ] || continue
        options+=("$name$([ "$attached" = "1" ] && printf '   (open elsewhere)')")
      done < <(ccssh_session_list "$host")

      if [ "${#options[@]}" -eq 0 ]; then
        say_info "no sessions open on $host — starting one"
        printf '%s\n' "$base"
        return 0
      fi

      status_clear
      chosen="$(ccssh_pick "Which session on $host?" "${options[@]}")" || return 1
      [ -n "$chosen" ] || return 1
      printf '%s\n' "${chosen%%   (open elsewhere)}"
      ;;
    *)
      ccssh_session_free_name "$host" "$base"
      ;;
  esac
}

run_local() {
  command -v claude >/dev/null 2>&1 ||
    die "local" "claude is not installed here" "see https://claude.ai/install.sh"
  exec claude
}

# --- entry point ------------------------------------------------------------

main() {
  local target='' explicit_path='' host dir branch='' worktree='' remembered
  local pick_folder=0 pick_branch=0 save_as='' environment=''
  local env_host env_dir env_branch

  while [ "$#" -gt 0 ]; do
    case "$1" in
      -h|--help)    usage; exit 0 ;;
      --version)    printf 'ccssh %s\n' "$CCSSH_VERSION_STRING"; exit 0 ;;
      --local)      run_local ;;
      --dry-run)    CCSSH_DRY_RUN=1 ;;
      -p|--pick)    pick_folder=1 ;;
      -b|--branch)  pick_branch=1 ;;
      -c|--continue) CCSSH_SESSION_MODE=continue ;;
      -r|--resume)   CCSSH_SESSION_MODE=resume ;;
      -v|--verbose)  CCSSH_VERBOSE=1 ;;
      --takeover)   CCSSH_TAKEOVER=1 ;;
      --save)       shift; save_as="${1:-}"
                    [ -n "$save_as" ] || die "usage" "--save needs a name" ;;
      --forget)     shift; forget_host "${1:-}"; exit 0 ;;
      -*)           usage; die "usage" "unknown option: $1" ;;
      *)            target="$1" ;;
    esac
    shift
  done

  # host:/path goes straight there, skipping every prompt.
  case "$target" in
    *:*) explicit_path="${target#*:}"; target="${target%%:*}" ;;
  esac

  require_cmd ssh
  require_cmd python3 "install python3 locally to shape credentials"

  if [ -z "$target" ]; then
    target="$(choose_host)" || exit 130
    [ -n "$target" ] || exit 130
  fi
  [ "$target" = "local" ] && run_local

  # Chosen from the menu, a bare host means "that machine, but let me choose
  # where" — the entry above it is the one carrying the remembered directory.
  # Typed as an argument it means the opposite: go straight there.
  case "$target" in
    resume:*) target="${target#resume:}" ;;
    host:*)   target="${target#host:}"
              [ -z "$explicit_path" ] && pick_folder=1 ;;
  esac

  # A name you wrote down wins over a bare host of the same name.
  case "$target" in
    env:*) environment="${target#env:}" ;;
    *)     ccssh_environment "$target" >/dev/null 2>&1 &&
             [ -n "$(ccssh_environment "$target")" ] && environment="$target" ;;
  esac

  if [ -n "$environment" ]; then
    IFS=$'\t' read -r env_host env_dir env_branch <<<"$(ccssh_environment "$environment")"
    [ -n "$env_host" ] || die "setup" "environment '$environment' has no sshHost"
    host="$env_host"
    [ -n "$env_dir" ] && [ -z "$explicit_path" ] && explicit_path="$env_dir"
    [ -n "$env_branch" ] && branch="$env_branch"
  else
    host="$target"
  fi

  # Memory is local and instant, so read it first: the probe can then confirm
  # the folder and look for an open session in the same round trip.
  remembered="$(ccssh_memory_get "$host")"
  IFS=$'\t' read -r dir branch worktree <<<"${remembered:-$'\t\t'}"

  candidate="${worktree:-$dir}"
  case "$candidate" in
    '~'*) candidate='' ;;  # needs the remote home, which the probe has yet to report
  esac

  prepare_remote "$host" "$candidate" \
    "$([ -n "$candidate" ] && ccssh_session_name "${dir:-$candidate}" "$branch")"

  # A quoted ~ would reach the remote shell as a literal, and the home it
  # refers to is only known now.
  dir="$(ccssh_expand_home "$dir" "$CCSSH_HOME")"
  worktree="$(ccssh_expand_home "$worktree" "$CCSSH_HOME")"

  if [ -n "$explicit_path" ]; then
    dir="$(ccssh_expand_home "$explicit_path" "$CCSSH_HOME")"
    branch=''; worktree=''
    ccssh_dir_exists "$host" "$dir" ||
      die "folder" "$dir does not exist on $host"
  elif [ "$pick_folder" = "1" ] || [ -z "$dir" ]; then
    dir="$(choose_folder "$host")" || exit 130
    branch=''; worktree=''
  elif [ "${CCSSH_DIR_EXISTS:-}" = "no" ] || \
       { [ -z "${CCSSH_DIR_EXISTS:-}" ] && ! ccssh_dir_exists "$host" "$dir"; }; then
    say_warn "$dir is gone on $host — choose another"
    dir="$(choose_folder "$host")" || exit 130
    branch=''; worktree=''
  fi

  if [ "$pick_branch" = "1" ] && [ -n "$CCSSH_GIT" ] && ccssh_is_repo "$host" "$dir"; then
    IFS=$'\t' read -r branch worktree < <(choose_branch "$host" "$dir")
  elif [ -n "$worktree" ] && ! ccssh_dir_exists "$host" "$worktree"; then
    warn "the remembered worktree is gone — using $dir instead"
    branch=''; worktree=''
  fi

  if [ -n "$save_as" ]; then
    ccssh_environment_save "$save_as" "$host" "$dir" "$branch"
    say_ok "saved environment '$save_as' — next time just: ccssh $save_as"
  fi

  run_remote "$host" "$dir" "$branch" "$worktree"
}

main "$@"
